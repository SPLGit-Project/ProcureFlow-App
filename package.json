{
  "name": "procureflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve-production.mjs",
    "test:stock": "node scripts/test_stock_accuracy.mjs",
    "test:packs": "node scripts/test_order_packs.mjs",
    "preview:packs": "node scripts/preview_order_packs.mjs",
    "test:startup": "node --test tests/startup/*.test.mjs",
    "dev": "vite --mode staging",
    "dev:prod": "vite --mode production",
    "build": "npm run build:prod",
    "build:staging": "tsc && vite build --mode staging",
    "build:prod": "tsc && vite build --mode production",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "dotenv": "17.3.1",
    "lucide-react": "^0.555.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-dropzone": "^14.3.8",
    "react-router-dom": "^7.10.1",
    "recharts": "^3.5.1",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
